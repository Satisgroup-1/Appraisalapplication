# Contact-form email delivery, via Resend (https://resend.com).
#
# The site builds and every page renders without these values. Only the contact
# form needs them: without RESEND_API_KEY the form returns a 503 and tells the
# visitor to email directly, which is the honest failure rather than a silent one.
#
# See docs/contact-email.md for the setup, including the DNS records.

# Required. Resend API key. Create at https://resend.com/api-keys with
# "Sending access" only — the site never reads or lists email.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Required in production. The verified sender. Resend rejects any address whose
# domain is not verified in the account. Without this the site falls back to
# Resend's shared onboarding sender, which can only deliver to the account
# owner — enough for a smoke test, and it disables the visitor acknowledgement.
CONTACT_FROM_EMAIL=Quiet Gears <enquiries@quietgears.co.uk>

# Optional. Where enquiries are delivered. Defaults to quietgearsai@gmail.com.
CONTACT_TO_EMAIL=quietgearsai@gmail.com

# Optional. A second copy of each enquiry, for a shared archive.
# CONTACT_BCC_EMAIL=archive@quietgears.co.uk
